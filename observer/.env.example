# Clé API xAI (console.x.ai). Utilise une clé dédiée au module de découverte.
XAI_API_KEY=
# Modèle et effort de raisonnement (grok-4.7 raisonne en HIGH par défaut : low suffit pour un scan).
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low

# Plafonds. x_search n'a pas de max_results. max_turns borne les TOURS : avec des appels parallèles,
# un tour peut contenir plusieurs recherches, donc ni les appels ni les posts ne sont plafonnés.
# false = au plus une recherche par tour (plus strict, scan plus pauvre).
OBSERVER_MAX_TURNS=3
OBSERVER_PARALLEL_TOOL_CALLS=true
# 600000 au maximum (le verrou de scan expire après 2 × timeout + 60 s).
OBSERVER_TIMEOUT_MS=300000
# Budget quotidien (UTC) et réserve exigée avant chaque scan.
OBSERVER_DAILY_BUDGET_USD=5
OBSERVER_SCAN_RESERVE_USD=2
# Seuils d'alerte par scan.
OBSERVER_ALERT_POSTS=150
OBSERVER_ALERT_SCAN_USD=1

# Stockage local du prototype (rapports, réponses brutes, budget, historique).
OBSERVER_DATA_DIR=data
# Laisser xAI conserver les requêtes/réponses (false = minimisation des données).
OBSERVER_STORE_AT_XAI=false
